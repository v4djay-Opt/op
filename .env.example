# ─────────────────────────────────────────────────────────────
# Optimax Studio — Environment Variables Reference
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# Site — canonical origin, no trailing slash, no www
NEXT_PUBLIC_SITE_URL=https://optimaxstudio.com

# Headless WordPress (wordpress/mu-plugins/optimax-headless.php)
WORDPRESS_URL=https://blog.optimaxstudio.com
# Must equal OPTIMAX_REVALIDATE_SECRET in wp-config.php (generate: openssl rand -hex 32)
WORDPRESS_REVALIDATE_SECRET=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
TO_EMAIL=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Analytics / Integrations
GOOGLE_ANALYTICS_ID=
GOOGLE_MAPS_API_KEY=
